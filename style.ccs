/* RESET PADRÃO */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  background: #f5f5f5;
  color: #333;
  line-height: 1.6;
}

html {
  scroll-behavior: smooth;
}

.container {
  width: 90%;
  max-width: 1200px;
  margin: auto;
}

/* HEADER & MENU */
.header {
  background: #f7941d;
  padding: 15px 0;
  position: relative;
  z-index: 1000;
}

.header-content, .nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 15px;
}

.logo-area {
  display: flex;
  align-items: center;
  gap: 12px;
  max-width: 520px;
}

.logo {
  height: 80px;
  width: auto;
}

.logo-text strong {
  font-size: 16px;
  display: block;
  font-weight: bold;
  color: #000;
}

.logo-text p {
  font-size: 11px;
  margin: 0;
  line-height: 1.3;
  font-weight: bold;
  color: #000;
}

.menu {
  display: flex;
  gap: 20px;
  list-style: none;
  font-weight: bold;
}

.menu li a {
  text-decoration: none;
  color: black;
  transition: 0.3s;
}

.menu li a:hover {
  color: white; 
}

.actions {
  display: flex;
  gap: 10px;
}

.btn-black {
  background: black;
  color: white;
  padding: 8px 15px;
  border-radius: 20px;
  text-decoration: none;
  font-size: 14px;
  font-weight: bold;
}

/* HERO SLIDER */
.hero {
  position: relative;
  width: 100%;
  height: 60vh;
  min-height: 400px;
  overflow: hidden;
}

.slides {
  display: flex;
  width: 100%;
  height: 100%;
  transition: transform 0.8s cubic-bezier(0.77, 0, 0.175, 1);
}

.slide {
  flex: 0 0 100%;
  height: 100%;
  background-size: cover;
  background-position: center;
}

.controls {
  position: absolute;
  bottom: 20px;
  width: 100%;
  text-align: center;
}

.controls span {
  display: inline-block;
  width: 12px;
  height: 12px;
  background: white;
  margin: 5px;
  border-radius: 50%;
  cursor: pointer;
  opacity: 0.5;
}

.controls span.active {
  opacity: 1;
}

/* VIDEO YOUTUBE */
.video {
  margin: 50px auto;
  max-width: 900px;
  width: 100%;
  box-shadow: 0 10px 25px rgba(0,0,0,0.15);
  border-radius: 10px;
  overflow: hidden;
}

.video iframe {
  width: 100%;
  aspect-ratio: 16 / 9;
  display: block;
}

/* ========================================================
   🔥 SEÇÃO DE NOTÍCIAS COMPLETA (SISTEMA ANTI-SOBREPOSIÇÃO)
   ======================================================== */
.noticias {
  padding: 60px 0;
}

.noticias h2 {
  margin-bottom: 30px;
  font-size: 28px;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 30px;
  align-items: start; /* Impede que um card estique o outro artificialmente */
}

/* O CARD AGORA É EXPANSÍVEL AUTOMATICAMENTE, NUNCA FIXO */
.card {
  background: white;
  border-radius: 12px;
  box-shadow: 0 5px 15px rgba(0,0,0,0.08);
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 15px;
  height: auto; /* Altera a altura de fixa para automática */
  min-height: 100px;
  overflow: hidden;
  transition: transform 0.3s, box-shadow 0.3s;
}

.card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 25px rgba(0,0,0,0.15);
}

/* Mosaicos dentro do card de notícias */
.card .mosaico {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 6px;
  width: 100%;
  aspect-ratio: 16 / 9; /* Mantém a proporção perfeita na tela */
  border-radius: 8px;
  overflow: hidden;
}

.card .mosaico.uma-imagem {
  grid-template-columns: 1fr;
}

.card .img-principal, .card .img-secundarias {
  height: 100%;
}

.card .img-secundarias {
  display: grid;
  gap: 6px;
}

.card .mosaico img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Quedas para imagens únicas tradicionais */
.card .fallback-img-container {
  width: 100%;
  aspect-ratio: 16 / 9;
  border-radius: 8px;
  overflow: hidden;
}

.card .fallback-img-container img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Conteúdo de Texto abaixo da Imagem */
.conteudo-card-noticia {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.card h3 {
  font-size: 20px;
  color: #111;
  line-height: 1.3;
  font-weight: bold;
}

.texto-noticia {
  color: #555;
  font-size: 14px;
  line-height: 1.6;
  text-align: justify;
}

/* ========================================================
   OUTRAS SEÇÕES (QUEM SOMOS, AGENDA, FOOTER)
   ======================================================== */
.quem-somos {
  background: linear-gradient(135deg, #d35400, #f7941d);
  padding: 60px 0;
  color: #fff;
}

.quem-somos h2 {
  text-align: center;
  margin-bottom: 25px;
}

.conteudo-quem {
  max-width: 900px;
  margin: auto;
  text-align: justify;
}

.conteudo-quem p {
  margin-bottom: 15px;
}

.agenda {
  padding: 60px 0;
}

.agenda-banner {
  background: linear-gradient(135deg, #f7941d, #ffb347);
  padding: 40px;
  border-radius: 15px;
  color: white;
  box-shadow: 0 10px 25px rgba(0,0,0,0.15);
}

.agenda-lista {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 20px;
  margin-top: 25px;
}

.evento {
  background: rgba(255,255,255,0.15);
  padding: 20px;
  border-radius: 10px;
  backdrop-filter: blur(5px);
  transition: 0.3s;
}

.evento:hover {
  transform: scale(1.03);
  background: rgba(255,255,255,0.25);
}

.social {
  display: flex;
  justify-content: center;
  gap: 20px;
  padding: 40px 0;
}

.social-btn {
  width: 50px;
  height: 50px;
  background: black;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  transition: 0.3s;
}

.social-btn i {
  color: white;
  font-size: 20px;
}

.social-btn:hover { transform: scale(1.1); }
.social-btn:nth-child(1):hover { background: #E1306C; }
.social-btn:nth-child(2):hover { background: #1877F2; }
.social-btn:nth-child(3):hover { background: #FF0000; }
.social-btn:nth-child(4):hover { background: #25D366; }

.footer {
  background: black;
  color: white;
  text-align: center;
  padding: 30px 20px;
  font-size: 14px;
}

.footer p {
  margin-bottom: 8px;
}

/* RESPONSIVIDADE CELULAR */
@media (max-width: 768px) {
  .header-content, .nav {
    flex-direction: column;
    text-align: center;
  }
  
  .logo-area {
    flex-direction: column;
  }

  .menu {
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  .menu li a {
    background: rgba(0,0,0,0.05);
    padding: 6px 12px;
    border-radius: 15px;
    font-size: 13px;
  }

  .hero {
    height: 40vh;
  }

  .cards {
    grid-template-columns: 1fr;
  }
}